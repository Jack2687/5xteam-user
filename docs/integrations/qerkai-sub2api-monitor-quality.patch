--- /dev/null
+++ b/backend/internal/repository/pro_restock_quality_test.go
@@ -0,0 +1,35 @@
+package repository
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"strconv"
+	"testing"
+)
+
+func TestProRestockQualityRejectsHiddenPipelineFailure(t *testing.T) {
+	for _, bad := range []string{"none", "slot", "waiting"} {
+		t.Run(bad, func(t *testing.T) {
+			server := miniredis.RunT(t)
+			client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+			defer client.Close()
+			cache := NewConcurrencyCache(client, 15, 900)
+			if bad == "slot" {
+				server.Set(accountSlotKeyPrefix+strconv.Itoa(2), "wrong-type")
+			}
+			if bad == "waiting" {
+				server.Set(accountWaitKeyPrefix+strconv.Itoa(2), "not-a-number")
+			}
+			loads, err := cache.GetAccountsLoadBatch(context.Background(), []service.AccountWithConcurrency{{ID: 1, MaxConcurrency: 10}, {ID: 2, MaxConcurrency: 10}})
+			if bad == "none" {
+				if err != nil || len(loads) != 2 || loads[1].CurrentConcurrency != 0 {
+					t.Fatalf("valid zero failed: %v", err)
+				}
+			} else if err == nil {
+				t.Fatal("redis.Nil on the first account hid a later failure")
+			}
+		})
+	}
+}
