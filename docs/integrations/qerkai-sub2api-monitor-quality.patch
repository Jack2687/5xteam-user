+++ b/backend/internal/service/pro_restock_quality_test.go
@@ -0,0 +1,33 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+type restockQualityCache struct {
+	ConcurrencyCache
+	fail bool
+}
+
+func (c *restockQualityCache) GetAccountsLoadBatch(context.Context, []AccountWithConcurrency) (map[int64]*AccountLoadInfo, error) {
+	if c.fail {
+		return nil, errors.New("redis failure")
+	}
+	return map[int64]*AccountLoadInfo{1: {AccountID: 1}}, nil
+}
+func TestProRestockQualityFreshCollection(t *testing.T) {
+	cache := &restockQualityCache{}
+	svc := &OpsService{concurrencyService: NewConcurrencyService(cache)}
+	accounts := []Account{{ID: 1, Concurrency: 10}}
+	first := svc.getAccountsLoadMapBestEffort(context.Background(), accounts)
+	if first[1] == nil || first[1].CurrentConcurrency != 0 {
+		t.Fatal("valid zero lost")
+	}
+	cache.fail = true
+	second := svc.getAccountsLoadMapBestEffort(context.Background(), accounts)
+	if len(second) != 0 {
+		t.Fatal("cached or failed load claimed as current")
+	}
+}
